{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "pcafe": ["./src/engine/public.ts"],
      "@pcafe/pro": ["./node_modules/@pcafe/pro/src/index.ts"],
      "@pcafe/pro/*": ["./node_modules/@pcafe/pro/*"]
    }
  },
  "include": ["src"]
}
